# Copiar a .env y rellenar. Nunca subir .env al repo.
# Lo leen docker compose, la API Java (al arrancar) y el Duende con: uvicorn ... --env-file ../.env

# ─── Duende (Python) ─────────────────────────────────────────────────────────
# Sin clave, el Duende responde igual: recomendaciones y chat por reglas. Con clave, el chat lo escribe Gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro
GEMINI_TIMEOUT_MS=20000
DUENDE_MAX_TOKENS=1024
# Respuestas nuevas de Gemini en 24 h (las de reglas y las repetidas no cuentan).
DUENDE_DAILY_LIMIT=200
# Con Gemini, el chat puede consultar a la API Java lo que no está en los resúmenes (un mapa, unas fechas, partidas
# concretas). API_URL vacía o DUENDE_MAX_CONSULTAS=0: sin consultas. Con docker compose, API_URL ya va puesta.
API_URL=http://localhost:8080
API_TIMEOUT_MS=5000
DUENDE_MAX_CONSULTAS=4

# ─── API (Java) ──────────────────────────────────────────────────────────────
# Genera jugadores y partidas de ejemplo si la base está vacía y no hay config/equipo.json.
TTCL_DEMO=true
# Zona del equipo: el Duende la usa para saber a qué hora del día juega cada uno.
TTCL_ZONA_HORARIA=Europe/Madrid
# Cuánto espera la API al Duende (con consultas, una respuesta de Gemini puede llevar varias llamadas).
DUENDE_TIMEOUT_MS=60000
# Solo con docker compose (Postgres). En local la API usa H2 en memoria.
DB_PASSWORD=ttcl

# ─── Fuentes de datos (opcionales: sin clave, ese juego no se sincroniza) ────
# CS2 vía FACEIT: https://developers.faceit.com (Data API, crear app y copiar la API key)
FACEIT_API_KEY=
# SMITE 2 vía Hi-Rez: dev ID y auth key se piden a Hi-Rez. La URL base la da su documentación de SMITE 2.
SMITE2_DEV_ID=
SMITE2_AUTH_KEY=
SMITE2_API_BASE=
SYNC_INTERVAL_MIN=60

# ─── Demos de CS2 (opcional, P12) ────────────────────────────────────────────
# El trabajador de analisis/ lee las demos y la API guarda cada ronda (KAST, trades, CT y T, dónde mueres...). Se
# analizan las que se dejen en la carpeta demos/ con el id de la partida al principio del nombre (las de la sala de la
# partida en FACEIT ya vienen así). La descarga automática por la API de FACEIT es de pago y no se usa. Con docker
# compose, ANALISIS_URL ya va puesta.
ANALISIS_URL=http://localhost:8001
ANALISIS_INTERVALO_MIN=15
# Tamaño máximo de una demo (comprimida o no) y cuánto se espera a descargarla.
ANALISIS_MAX_MB=800
ANALISIS_TIMEOUT_S=300

# ─── Discord (opcional) ──────────────────────────────────────────────────────
# Webhook de un canal (Editar canal → Integraciones → Webhooks): la API publica ahí las partidas nuevas tras cada
# sincronización, con lo que dice el Duende, y el resumen de la semana. Vacío: no publica nada (el bot del grupo puede
# leer GET /api/novedades). El resumen, por defecto los lunes a las 10 (cron de Spring, en la zona del equipo).
DISCORD_WEBHOOK_URL=
DISCORD_LANG=es
DISCORD_RESUMEN_SEMANAL=0 0 10 * * MON

# ─── Web ─────────────────────────────────────────────────────────────────────
# Puerto de la web con docker compose.
WEB_PORT=4200
