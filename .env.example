# Copiar a .env y rellenar. Nunca subir .env al repo.

# ─── Base de datos (obligatoria) ─────────────────────────────────────────────
DATABASE_URL=postgres://usuario:clave@localhost:5432/ttcl

# ─── Duende (Gemini) ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_TIMEOUT_MS=20000
DUENDE_MAX_TOKENS=1024
# Textos nuevos que puede generar el Duende en 24 h (los guardados no cuentan).
DUENDE_DAILY_LIMIT=50

# ─── Fuentes de datos (opcionales: sin clave, ese juego no se sincroniza) ────
# CS2 vía FACEIT: https://developers.faceit.com (Data API, crear app y copiar la API key)
FACEIT_API_KEY=
# SMITE 2 vía Hi-Rez: dev ID y auth key se piden a Hi-Rez. La URL base la da su documentación de SMITE 2.
SMITE2_DEV_ID=
SMITE2_AUTH_KEY=
SMITE2_API_BASE=

# ─── Worker ──────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MIN=60
